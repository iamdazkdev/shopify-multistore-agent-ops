{
  "name": "shopify-multistore-agent-ops",
  "version": "2.0.0",
  "description": "Agent-orchestrated multi-store Shopify inventory, delivery-date metafield, localization, cross-hub sync, and live QA pipeline for Transformer Table International D2C.",
  "type": "module",
  "private": true,
  "scripts": {
    "demo": "node src/pipeline.js --input data/warehouse-eta-sheet.csv --auto-approve",
    "plan": "node src/pipeline.js --input data/warehouse-eta-sheet.csv --plan-only",
    "sync": "node src/pipeline.js --input data/warehouse-eta-sheet.csv",
    "qa": "node src/qa-audit.js --snapshot data/mock-storefronts.snapshot.json",
    "qa:clean": "node src/qa-audit.js --snapshot artifacts/post-sync-storefronts.json",
    "live:qa": "python3 src/live-store-provisioner.py",
    "live:ops": "python3 src/live-ops-cli.py",
    "live:enterprise": "python3 src/enterprise-pod-suite.py",
    "live:jd-complete": "python3 src/role3-complete-jd-engine.py",
    "demo:eta-shift": "python3 src/live-demo-trainer.py --action shift-eta",
    "demo:reset": "python3 src/live-demo-trainer.py --action reset",
    "market:launch:sg": "python3 src/enterprise-pod-suite.py --launch-market SG",
    "demo:engineer": "node src/webhook-rpa-engine.js",
    "test": "node --test tests/pipeline.test.js tests/guard-hook.test.js && python3 -m unittest discover -s tests -p 'test_*.py'",
    "live:3pl:plan": "python3 src/live-ops-cli.py sync-3pl",
    "live:3pl:apply": "python3 src/live-ops-cli.py sync-3pl --apply",
    "audit": "python3 src/store_audit.py",
    "audit:record": "python3 src/store_audit.py --record",
    "audit:baseline": "python3 src/store_audit.py --save-baseline",
    "audit:diff": "python3 src/store_audit.py --diff-baseline",
    "build:plan": "python3 src/store_build.py",
    "build:apply": "python3 src/store_build.py --apply",
    "validate:gql": "python3 src/validate_graphql.py"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
