      hub: 'Dubai Jebel Ali Free Zone 3PL Hub (3–5 Business Days)',
      pay: 'Tabby (Split in 4) · Tamara · Apple Pay · Mada / Cards',
      vatBadge: 'Incl. 5% UAE VAT',
      lang: 'en',
      key: 'gcc'
    },
    SG: {
      name: '🇸🇬 Singapore Storefront (sg.transformertable.com)',
      vat: 'DDP — 9% Singapore GST Included (IRAS Reg)',
      hub: 'Changi South Logistics 3PL Hub (2–4 Business Days)',
      pay: 'Atome (3 Payments) · GrabPay · PayNow · Cards',
      vatBadge: 'Incl. 9% SG GST',
      lang: 'en',
      key: 'sg'
    }
  };

  function switchTTMarket(code, btnEl) {
    const m = TT_MARKETS[code];
    if (!m) return;
    document.querySelectorAll('.tt-market-btn').forEach(b => b.classList.remove('active'));
    if (btnEl) btnEl.classList.add('active');

    document.getElementById('tt-m-name').textContent = m.name;
    document.getElementById('tt-m-vat').textContent = m.vat;
    document.getElementById('tt-m-hub').textContent = m.hub;
    document.getElementById('tt-m-pay').textContent = m.pay;

    document.querySelectorAll('.tt-price-now').forEach(el => {
      const val = el.getAttribute('data-' + m.key);
      if (val) el.textContent = val;
    });
    document.querySelectorAll('.tt-price-was').forEach(el => {
      const val = el.getAttribute('data-' + m.key);
      if (val) el.textContent = val;
    });
    document.querySelectorAll('.tt-vat-tag').forEach(el => {
      el.textContent = m.vatBadge;
    });
    document.querySelectorAll('.tt-card-title').forEach(el => {
      const title = el.getAttribute('data-' + m.lang) || el.getAttribute('data-en');
      if (title) el.textContent = title;
    });
  }
</script>

