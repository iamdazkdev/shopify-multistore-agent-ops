  </aside>

</div>

<script>
  const ECOM_MARKETS = {
    UK: {
      sub: 'United Kingdom Storefront · GBP (£)',
      heroTitle: '1 Table. 6 Sizes. Seats 1 to 12 Effortlessly.',
      cta1: 'Shop Dining Tables — From £1,695',
      hub: '🚚 Coventry UK 3PL Hub',
      eta: 'Express 3–5 Day White-Glove Delivery',
      vat: '🧾 20% UK VAT Included',
      pay: 'Klarna UK (Pay in 3) · Clearpay · Apple Pay',
      vatBadge: 'Incl. 20% UK VAT',
      lang: 'en',
      key: 'uk'
    },
    DE: {
      sub: 'Deutschland Storefront · EUR (€) · Inkl. 19% MwSt.',
      heroTitle: '1 Tisch. 6 Größen. Platz für 1 bis 12 Personen.',
      cta1: 'Esstische Entdecken — Ab €1.895',
      hub: '🚚 EU-Zentrallager Rotterdam',
      eta: 'Kostenlose 2-Mann-Lieferung in 3–5 Werktagen',
      vat: '🧾 Inkl. 19% MwSt. (EU-OSS)',
      pay: 'Klarna Rechnung (30 Tage) · Sofort · SEPA · PayPal',
      vatBadge: 'Inkl. 19% MwSt.',
      lang: 'de',
      key: 'de'
    },
    FR: {
      sub: 'Boutique France & Belgique · EUR (€) · TVA 20% Incluse',
      heroTitle: '1 Table. 6 Tailles. De 1 à 12 Convives en 60 Secondes.',
      cta1: 'Découvrir les Tables — Dès €1.895',
      hub: '🚚 Entrepôt Central UE Rotterdam',
      eta: 'Livraison Gants Blancs en 5–8 Jours Ouvrés',
      vat: '🧾 TVA 20% Incluse (Sans Frais de Douane)',
      pay: 'Alma (3x / 4x Sans Frais) · Carte Bancaire · PayPal',
      vatBadge: 'TVA 20% Incluse',
      lang: 'fr',
      key: 'fr'
    },
    AU: {
      sub: 'Australia Storefront · AUD (A$) · 10% GST Included',
      heroTitle: '1 Table. 6 Sizes. Seats 1 to 12 Effortlessly.',
      cta1: 'Shop Dining Tables — From A$2,995',
      hub: '🚚 Sydney NSW 3PL Hub',
      eta: 'Metro White-Glove Delivery in 4–6 Business Days',
      vat: '🧾 10% Australian GST Included',
      pay: 'Afterpay · Zip Money · PayID · Apple Pay',
      vatBadge: 'Incl. 10% AU GST',
      lang: 'en',
      key: 'au'
    },
    GCC: {
      sub: 'UAE & GCC Storefront · AED · 5% UAE VAT Included',
      heroTitle: '1 Table. 6 Sizes. Seats 1 to 12 Effortlessly.',
      cta1: 'Shop Dining Tables — From AED 7,495',
      hub: '🚚 Dubai Jebel Ali 3PL Hub',
      eta: 'Free White-Glove Assembly in 3–5 Business Days',
      vat: '🧾 5% UAE Federal VAT Included',
      pay: 'Tabby (4 Payments) · Tamara · Apple Pay · Mada',
      vatBadge: 'Incl. 5% UAE VAT',
      lang: 'en',
      key: 'gcc'
    },
    SG: {
      sub: 'Singapore Storefront · SGD (S$) · 9% GST Included',
      heroTitle: '1 Table. 6 Sizes. Seats 1 to 12 Effortlessly.',
      cta1: 'Shop Dining Tables — From S$2,695',
      hub: '🚚 Singapore Changi 3PL Hub',
      eta: 'Express White-Glove Delivery in 2–4 Business Days',
      vat: '🧾 9% Singapore GST Included',
      pay: 'Atome (3 Payments) · GrabPay · PayNow · Cards',
      vatBadge: 'Incl. 9% SG GST',
      lang: 'en',
      key: 'sg'
    }
  };

  function setEcomMarket(code, btnEl) {
    const m = ECOM_MARKETS[code];
    if (!m) return;
    document.querySelectorAll('.tt-flag-btn').forEach(b => b.classList.remove('active'));
    if (btnEl) btnEl.classList.add('active');

    document.getElementById('tt-store-subtitle').textContent = m.sub;
    document.getElementById('tt-hero-title').textContent = m.heroTitle;
    document.getElementById('tt-hero-cta1').textContent = m.cta1;
    document.getElementById('tt-trust-hub').textContent = m.hub;
    document.getElementById('tt-trust-eta').textContent = m.eta;
    document.getElementById('tt-trust-vat').textContent = m.vat;
    document.getElementById('tt-trust-pay-sub').textContent = m.pay;

    document.querySelectorAll('.tt-price-current').forEach(el => {
      const val = el.getAttribute('data-' + m.key);
      if (val) el.textContent = val;
    });
    document.querySelectorAll('.tt-price-compare').forEach(el => {
      const val = el.getAttribute('data-' + m.key);
      if (val) el.textContent = val;
    });
    document.querySelectorAll('.tt-vat-pill').forEach(el => {
      el.textContent = m.vatBadge;
    });
    document.querySelectorAll('.tt-pcard-title').forEach(el => {
      const title = el.getAttribute('data-' + m.lang) || el.getAttribute('data-en');
      if (title) el.textContent = title;
    });
  }

  function setTableSize(text, btnEl) {
    document.querySelectorAll('.tt-size-pill').forEach(b => b.classList.remove('active'));
    if (btnEl) btnEl.classList.add('active');
    document.getElementById('tt-size-caption').innerHTML = 'Selected Mode: <strong>' + text + '</strong>';
  }

  function selectFinish(swatchEl, etaText, etaBoxId) {
    const row = swatchEl.parentElement;
    row.querySelectorAll('.tt-swatch').forEach(s => s.classList.remove('active'));
    swatchEl.classList.add('active');
    const box = document.getElementById(etaBoxId);
    if (box) box.innerHTML = '🚚 <strong>Selected Finish Delivery:</strong> ' + etaText;
  }

  function filterCatalog(cat, btnEl) {
    if (btnEl) {
      document.querySelectorAll('.tt-filter-btn').forEach(b => b.classList.remove('active'));
      btnEl.classList.add('active');
    }
    document.querySelectorAll('.tt-pcard').forEach(card => {
      if (cat === 'all' || card.getAttribute('data-cat') === cat) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }

  function toggleTTCart(open) {
    const ov = document.getElementById('tt-cart-overlay');
    const dr = document.getElementById('tt-cart-drawer');
    if (open) {
      ov.classList.add('open');
      dr.classList.add('open');
    } else {
      ov.classList.remove('open');
      dr.classList.remove('open');
    }
  }

  function addToTTCart(title, finish, price, eta) {
    document.getElementById('tt-cart-item-title').textContent = title;
    document.getElementById('tt-cart-item-variant').textContent = 'Finish: ' + finish + ' · Qty: 1';
    document.getElementById('tt-cart-item-price').textContent = price;
    document.getElementById('tt-cart-item-eta').textContent = eta;
    toggleTTCart(true);
  }
</script>

