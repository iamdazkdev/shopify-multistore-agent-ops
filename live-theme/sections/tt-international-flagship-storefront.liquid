    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
  .tt-logo {
    text-decoration: none;
    color: var(--tt-ink);
    display: flex;
    flex-direction: column;
  }
  .tt-logo-main {
