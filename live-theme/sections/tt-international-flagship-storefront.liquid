  .tt-btn-shop:hover { background: var(--tt-walnut-dark); }
  .tt-btn-outline {
    background: #ffffff;
    color: #1c1917;
    border: 1.5px solid #d6d3d1;
    text-decoration: none;
    padding: 15px 24px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 600;
  }
  .tt-trust-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
