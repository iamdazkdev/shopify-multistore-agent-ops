  .tt-filter-btn.active {
    background: #1c1917;
    color: #ffffff;
    border-color: #1c1917;
  }

  .tt-product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
    gap: 28px;
  }
  .tt-pcard {
    background: #ffffff;
    border: 1px solid var(--tt-border);
    border-radius: 20px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s, box-shadow 0.2s;
