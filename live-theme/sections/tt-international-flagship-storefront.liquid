  .tt-delivery-box {
    background: #faf8f5;
    border: 1px solid var(--tt-border);
    border-radius: 12px;
    padding: 12px 14px;
    font-size: 12px;
    color: #292524;
    margin-bottom: 16px;
  }
  .tt-delivery-box strong { color: #15803d; }
  .tt-add-btn {
    width: 100%;
    background: #1c1917;
    color: #ffffff;
    border: none;
    padding: 14px 20px;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s;
  }
  .tt-add-btn:hover {
    background: var(--tt-walnut);
  }

  /* 6. LOCAL PAYMENT & SHIPPING PROMISE STRIP */
  .tt-value-strip {
    background: #ffffff;
    border-top: 1px solid var(--tt-border);
    border-bottom: 1px solid var(--tt-border);
    padding: 40px 24px;
    margin-top: 56px;
