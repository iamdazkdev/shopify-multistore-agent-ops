  .tt-pcard:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 32px rgba(28, 25, 23, 0.08);
  }
  .tt-pcard-media {
    position: relative;
    height: 270px;
    background: #f5f5f4;
    overflow: hidden;
  }
  .tt-pcard-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .tt-pcard-tag {
    position: absolute;
    top: 14px;
    left: 14px;
    background: #1c1917;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 999px;
    letter-spacing: 0.04em;
