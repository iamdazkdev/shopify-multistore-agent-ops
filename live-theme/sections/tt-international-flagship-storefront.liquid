    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
  }
  .tt-value-item h4 { margin: 0 0 6px; font-size: 16px; font-weight: 800; color: #1c1917; }
  .tt-value-item p { margin: 0; font-size: 13px; color: var(--tt-muted); line-height: 1.55; }

  /* 7. LUXURY E-COMMERCE FOOTER */
  .tt-footer {
    background: #1c1917;
    color: #d6d3d1;
    padding: 56px 24px 40px;
  }
  .tt-footer-grid {
    max-width: 1360px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    gap: 36px;
  }
  @media (max-width: 900px) {
    .tt-footer-grid { grid-template-columns: 1fr 1fr; }
  }
  .tt-footer h5 {
    color: #ffffff;
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 14px;
  }
  .tt-footer ul { list-style: none; padding: 0; margin: 0; }
  .tt-footer li { margin-bottom: 9px; }
  .tt-footer a { color: #a8a29e; text-decoration: none; font-size: 13px; }
  .tt-footer a:hover { color: #ffffff; }

  /* 8. SLIDE-OUT SHOPPING CART DRAWER */
  .tt-cart-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: 90;
    display: none;
  }
  .tt-cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 420px;
    max-width: 92vw;
    background: #ffffff;
    z-index: 100;
    box-shadow: -10px 0 30px rgba(0,0,0,0.2);
    display: none;
    flex-direction: column;
    justify-content: space-between;
  }
  .tt-cart-overlay.open, .tt-cart-drawer.open { display: flex; }
</style>

