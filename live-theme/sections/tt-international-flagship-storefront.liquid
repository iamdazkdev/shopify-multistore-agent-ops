    align-items: baseline;
    gap: 10px;
    margin: 8px 0 14px;
  }
  .tt-price-current {
    font-size: 24px;
    font-weight: 800;
    color: #1c1917;
  }
  .tt-price-compare {
    font-size: 15px;
    color: #a8a29e;
    text-decoration: line-through;
  }
  .tt-vat-pill {
    font-size: 11px;
    font-weight: 700;
    color: var(--tt-green);
    background: var(--tt-green-bg);
    padding: 3px 8px;
    border-radius: 6px;
