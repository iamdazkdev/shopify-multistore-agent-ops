# Live Shopify Plus Store (Client Credentials OAuth Grant — Admin API 2025-01)
SHOPIFY_SHOP_DOMAIN=dazk-dev-sandbox-store.myshopify.com
SHOPIFY_CLIENT_ID=your_shopify_app_client_id
SHOPIFY_CLIENT_SECRET=shpss_replace_with_your_client_secret

# Regional Expansion Store Overrides (Admin API 2025-01)
SHOPIFY_UK_DOMAIN=modular-living-uk.myshopify.com
SHOPIFY_UK_ADMIN_TOKEN=shpat_replace_me
SHOPIFY_UK_LOCATION_GID=gid://shopify/Location/100000001

SHOPIFY_DE_DOMAIN=modular-living-de.myshopify.com
SHOPIFY_DE_ADMIN_TOKEN=shpat_replace_me
SHOPIFY_DE_LOCATION_GID=gid://shopify/Location/100000002

SHOPIFY_AU_DOMAIN=modular-living-au.myshopify.com
SHOPIFY_AU_ADMIN_TOKEN=shpat_replace_me
SHOPIFY_AU_LOCATION_GID=gid://shopify/Location/100000003

# Optional LLM key for AI copy localization (falls back to deterministic glossary localizer when unset)
OPENAI_API_KEY=
