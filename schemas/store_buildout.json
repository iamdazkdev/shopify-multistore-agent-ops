  "pages": [
    { "handle": "about", "title": "About", "body": "<p>One table that seats one person on a weekday and twelve at a family dinner. Every piece in this collection extends, stacks or folds so a small home can host like a big one.</p><p><em>This is an interview sandbox store built to demonstrate multi-market Shopify operations. It is not an official Transformer Table store.</em></p>" },
    { "handle": "how-it-transforms", "title": "How It Transforms", "body": "<p>Telescopic steel tracks run under the tabletop. Pull the ends apart, drop in the stored leaves, and the table grows in 30 cm steps. No tools, no loose parts.</p><ol><li>Pull both ends outward until the track clicks.</li><li>Lift a leaf from the storage slot and set it on the pins.</li><li>Push the ends together to lock.</li></ol>" },
    { "handle": "delivery-and-returns", "title": "Delivery & Returns", "body": "<p>Delivery dates shown on each product come from our 3PL stock per country and update when a container moves. The date you see at checkout is saved on your order.</p><ul><li>In stock locally: 3–5 business days.</li><li>Low stock: 5–8 business days.</li><li>Pre-order: the batch window shown on the product.</li></ul><p>Returns: 30 days in the UK and Australia; the statutory 14-day withdrawal right applies in the EU. Draft text, pending legal review per market.</p>" },
    { "handle": "warranty", "title": "Warranty", "body": "<p>10 years on frames and tracks for tables, benches and storage; 5 years on chairs, stools and outdoor pieces. Consumer law in your country applies in addition to this warranty. Draft text, pending legal review.</p>" },
    { "handle": "care-guide", "title": "Care Guide", "body": "<p>Wipe with a damp cloth, dry straight away, and re-oil twice a year with the Hardwood Care Kit. Keep the tracks free of crumbs and use the dry lubricant once a year.</p>" },
    { "handle": "faq", "title": "FAQ", "body": "<h3>How long does delivery take?</h3><p>The window on the product page is calculated from the stock in your country's warehouse.</p><h3>Are prices shown with tax?</h3><p>Yes in the UK, EU, Australia and the GCC: the price you see includes local VAT or GST.</p><h3>Can I order a finish that is out of stock?</h3><p>Some finishes are open for pre-order. The batch window is shown before you pay and saved on your order.</p>" }
  ],

  "articles": [
    { "title": "How to choose an expandable dining table for a small flat", "tags": ["buying-guide", "dining"], "body": "<p>Measure the room at its everyday size, not the dinner-party size. A table that is 46 cm deep when closed leaves a walkway in most hallways; one that opens to 3 m needs a clear run along one wall.</p><p>Check the mechanism: telescopic tracks keep the leaves aligned; loose leaves need storage space.</p>" },
    { "title": "Hosting twelve in 40 square metres: a planning checklist", "tags": ["hosting"], "body": "<p>Plan seating first: a bench seats more people per metre than chairs. Stackable chairs live in a corner until needed.</p><p>Extend the table the day before and check the floor protectors are on every leg.</p>" },
    { "title": "Caring for oiled hardwood through the seasons", "tags": ["care"], "body": "<p>Central heating dries wood in winter. Re-oil in autumn and spring, keep the table away from radiators, and wipe spills straight away.</p>" },
    { "title": "Oak, hickory, walnut or sequoia: choosing a finish", "tags": ["buying-guide"], "body": "<p>Oak is light and hides scratches. Hickory has a strong grain. Walnut is darker and shows dust. Sequoia is a limited batch with a warm red tone. Order the sample kit to see them in your light.</p>" },
    { "title": "What 'pre-order' means for your delivery date", "tags": ["delivery"], "body": "<p>When a finish is between containers, you can still order it. The window shown is the batch arrival plus local delivery. If a container moves, we update the window on the product and tell customers whose dates changed.</p>" },
    { "title": "Work-from-home without a home office", "tags": ["workspace"], "body": "<p>A console that becomes a desk keeps work out of sight in the evening. Leave 70 cm of depth for a laptop and a notebook.</p>" }
  ],

